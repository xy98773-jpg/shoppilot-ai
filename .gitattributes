# 仓库内统一 LF，避免 Windows(autocrlf) 造成整文件 diff 噪音
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件：禁止换行转换与合并
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.xls    binary
*.xlsx   binary
*.doc    binary
*.docx   binary
*.ppt    binary
*.pptx   binary
*.jar    binary

# Markdown 差异按语言高亮
*.md diff=markdown
