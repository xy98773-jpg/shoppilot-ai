# =============================================================================
# ShopPilot AI —— 部署环境变量样例（M1-T10）
# =============================================================================
# 用法：cp deploy/.env.example deploy/.env，再把所有 CHANGE_ME_* 换成真实值。
#   ★ deploy/.env 已被 .gitignore 忽略（.env / .env.* / !.env.example），不会入仓。
#   ★ 本文件只放占位值，严禁写入任何真实口令/密钥（CODING_STANDARDS：密钥不入仓）。
#
# 变量名与 PROJECT_STRUCTURE.md §7.2 一致。
# 未设置时，compose 内联的【本地开发默认值】生效（仅限本机 dev，不具备安全性）。
# =============================================================================

# ---------- 数据库（PROJECT_STRUCTURE §7.2）----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=shoppilot
MYSQL_USER=shoppilot
MYSQL_PASSWORD=CHANGE_ME_app_password

# ---------- Java ↔ Python 内部认证（DESIGN_BASIS §13.3）----------
# backend-java 与 service-ai 间调用携带 X-Internal-Token
AI_INTERNAL_TOKEN=CHANGE_ME_internal_token

# ---------- LLM 接入（TECH_STACK §1.3.1）----------
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=CHANGE_ME_llm_api_key
LLM_MODEL=CHANGE_ME_llm_model

# ---------- JWT 认证（DESIGN_BASIS §15 D-01：Access 2h / Refresh 7d；M2-T02 落地）----------
# ★ 密钥红线：JWT_SECRET 绝不入仓，部署时由环境/密钥管理注入（≥32 字节，HS256 要求）。
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800

# ---------- 运行参数 ----------
JAVA_OPTS=-Xms256m -Xmx512m
SPRING_PROFILES_ACTIVE=dev

# ---------- 宿主端口覆盖（默认值与 PROJECT_STRUCTURE §7.1 一致）----------
# 对外 nginx 端口；本机若与其它服务冲突可改（例：8081）
NGINX_PORT=80
# backend-java 开发态端口（仅 dev compose 生效）
BACKEND_PORT=8080
# mysql 开发态端口（仅 dev compose 生效）
MYSQL_PORT=3306
