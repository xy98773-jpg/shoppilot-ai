# =============================================================================
# ShopPilot AI —— 部署环境变量样例（M1-T10）
# =============================================================================
# 用法：cp deploy/.env.example deploy/.env，再把所有 CHANGE_ME_* 换成真实值。
#   ★ deploy/.env 已被 .gitignore 忽略（.env / .env.* / !.env.example），不会入仓。
#   ★ 本文件只放占位值，严禁写入任何真实口令/密钥（CODING_STANDARDS：密钥不入仓）。
#
# 变量名与 PROJECT_STRUCTURE.md §7.2 一致。
# 未设置时，compose 内联的【本地开发默认值】生效（仅限本机 dev，不具备安全性）。
# =============================================================================

# ---------- 数据库（PROJECT_STRUCTURE §7.2）----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=shoppilot
MYSQL_USER=shoppilot
MYSQL_PASSWORD=CHANGE_ME_app_password

# ---------- Java ↔ Python 内部认证（DESIGN_BASIS §13.3）----------
# backend-java 与 service-ai 间调用携带 X-Internal-Token
AI_INTERNAL_TOKEN=CHANGE_ME_internal_token
# M4-B14（R100）：两个方向的基础地址，变量名刻意不同（同名反义曾是配置缺陷）。
#   AI_SERVICE_BASE_URL  = backend-java 调用 service-ai 的地址（application.yml 读此名）
#   JAVA_BACKEND_BASE_URL = service-ai 回调 backend-java 的地址（Python config 读此名）
# ★ compose 侧为 ${VAR:-默认} 形态，此处 .env 中填的值可覆盖该默认。
AI_SERVICE_BASE_URL=http://service-ai:8000
JAVA_BACKEND_BASE_URL=http://backend-java:8080

# ---------- 分析任务轮询（M4-B20.4.1 / R143）----------
# 默认 true：打开「定时轮询 + timeout_at 超时扫描」（AnalysisRunPollTask）。
# ★ application.yml 内默认 false 是刻意为之（护住 34+ 个 @SpringBootTest，避免测试后台真打 Python），
#   因此**部署侧必须显式注入本变量**，否则默认部署下两条推进通道会同时缺失。
# 关闭（false）后：读时同步仍生效——GET /runs/{id} 会向 service-ai 拉一次状态并推进
#   （R143 修复后该通道可用）；但失去定时推进与超时兜底，不建议在生产关闭。
ANALYSIS_POLL_ENABLED=true

# ---------- LLM 接入（TECH_STACK §1.3.1；M8-T07 / R155 实装）----------
# OpenAI 兼容端点，默认 DeepSeek。★ 客户端会自动拼 /chat/completions，此处不要带路径。
LLM_BASE_URL=https://api.deepseek.com
# ★ 真实密钥只填在 deploy/.env（已 gitignore），绝不入仓。
#   未配置时 LLM 步骤按 SKIPPED 降级，规则结果照常返回，run 不会失败。
LLM_API_KEY=CHANGE_ME_llm_api_key
# DeepSeek 通用对话模型
LLM_MODEL=deepseek-chat
# 可选覆盖（均有默认值，见 service-ai/app/core/config.py）
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2
# 单次 run 最多解释多少个 SKU（串行调用，控成本与延迟）
LLM_MAX_ITEMS=20

# ---------- JWT 认证（DESIGN_BASIS §15 D-01：Access 2h / Refresh 7d；M2-T02 落地）----------
# ★ 密钥红线：JWT_SECRET 绝不入仓，部署时由环境/密钥管理注入（≥32 字节，HS256 要求）。
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800

# ---------- 运行参数 ----------
# ★ M7-T02（R194）实测：1 万行导入 confirm ≈ 60s，贴住 NFR-PERF-02 的 60s 门槛；
#   JVM 堆从 512m 调到 1536m 有可见收益（逐行落库 + 事件构造/JSON 序列化偏 GC 敏感）。
#   导入重的部署建议 -Xmx1536m 或以上；纯查询型内网部署可维持 512m。
JAVA_OPTS=-Xms256m -Xmx1536m
SPRING_PROFILES_ACTIVE=dev

# ---------- 宿主端口覆盖（默认值与 PROJECT_STRUCTURE §7.1 一致）----------
# 对外 nginx 端口；本机若与其它服务冲突可改（例：8081）
NGINX_PORT=80
# backend-java 开发态端口（仅 dev compose 生效）
BACKEND_PORT=8080
# mysql 开发态端口（仅 dev compose 生效）
MYSQL_PORT=3306
