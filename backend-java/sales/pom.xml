<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shoppilot</groupId>
        <artifactId>shoppilot-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shoppilot-sales</artifactId>
    <name>ShopPilot Sales</name>
    <description>销售数据（依赖：catalog, common）</description>

    <dependencies>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-common</artifactId>
        </dependency>
        <!-- M3-T12（B8）：销售 upsert 必须写审计 SALES_DAILY_UPSERT（DATABASE_DESIGN §6-J.1 #17 /
             IMPORT_WORKFLOW:265），为免重蹈 R66（B7 策略 upsert 无审计）。audit 为叶子模块
             （仅依赖 common），sales → audit 不构成环（MODULE_BOUNDARIES §2.10 / F-40 裁定）。 -->
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-audit</artifactId>
        </dependency>
        <!-- 实体/DTO 的 getter/setter 与构造（与其它业务模块一致用 provided 作用域）。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
