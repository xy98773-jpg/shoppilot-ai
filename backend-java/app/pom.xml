<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shoppilot</groupId>
        <artifactId>shoppilot-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shoppilot-app</artifactId>
    <name>ShopPilot App</name>
    <description>组合根 / 启动模块（第 11 模块，非业务）。DAG 顶点：依赖全部 10 业务模块 + common；被依赖 = 无。禁放 Controller/Service/Mapper/业务实体。</description>

    <dependencies>
        <!-- ★硬约束①：显式列出全部 10 个业务模块，不靠传递依赖（组件扫描 classpath 无歧义） -->
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-common</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-identity</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-catalog</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-importdata</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-inventory</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-sales</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-analysis</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-replenishment</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-purchasing</artifactId></dependency>
        <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-audit</artifactId></dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- M1-T06：Actuator 健康检查（/actuator/health；暴露面由 application.yml 收敛为 health,info。
             M8-T02（R195 / NFR-OBS-02）起追加 prometheus，见下一行）。
             置于 app（运行时/运维能力），与 flyway / mysql-connector 同类；业务模块不感知。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- M8-T02（R195 / NFR-OBS-02）：Prometheus 抓取格式的 MeterRegistry。
             ★ 必须显式引入：actuator starter 只带 SimpleMeterRegistry，
             缺它时 /actuator/prometheus 虽在暴露白名单里，实际返回 COM-0003（资源不存在），
             指标一个都抓不到——「端点开了但没数据」比「端点没开」更难排查。
             版本随 spring-boot-dependencies BOM 管理。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- M1-T05：数据库迁移与驱动。
             注：Spring Boot 3.x 无 spring-boot-starter-flyway（该 starter 自 Boot 4.0 起才有），
             正确做法是引入 flyway-core + flyway-mysql（MySQL 支持自 Flyway 9 起拆分为独立模块），
             版本由 spring-boot-dependencies BOM 管理（3.5.16 → Flyway 11.7.2）。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- M1-T11：版本守卫负向集成测试（Testcontainers 拉 mysql:8.0.12 断言启动被阻断）。
             把 M1-T05 那次手工 3308 取证固化为可重复 CI（DEVELOPMENT_PLAN:205）。
             版本显式锁定：Spring Boot BOM 不管理 Testcontainers。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <!-- ★M2-Foundation 回归修复（M1-T11 遗留 P0）：spring-jdbc 必须为 compile 作用域。
             M1-T11 为「测试内手动构造 DataSource」把本依赖声明为 test，结果按 Maven
             「就近胜出（nearest wins）」覆盖了经
               app → common → mybatis-plus-spring-boot3-starter → spring-boot-starter-jdbc
             传入的 compile 传递依赖 —— 就近的 depth-1 节点胜出后，spring-jdbc/spring-tx
             的运行期作用域被降级为 test，**不会打进 fat jar**。后果：DataSourceAutoConfiguration
             因缺 EmbeddedDatabaseType 不匹配 → 无 DataSource bean → Flyway / MySQLVersionGuard
             连带失败 → 应用启动即崩（CI 只跑 mvn verify，测试类路径仍可见 spring-jdbc，故看不见）。
             此处显式声明为运行期依赖以固化该约束（版本由 spring-boot-dependencies BOM 管理）。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <!-- M1-T06：生成 META-INF/build-info.properties，供 GET /api/v1/health 读取服务名与版本
                         （BuildProperties 由 ProjectInfoAutoConfiguration 在存在该资源时装配）。 -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
