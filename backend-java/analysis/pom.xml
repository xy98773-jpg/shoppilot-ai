<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shoppilot</groupId>
        <artifactId>shoppilot-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shoppilot-analysis</artifactId>
    <name>ShopPilot Analysis</name>
    <description>分析任务与结果（依赖：inventory, sales, catalog, common）</description>

    <dependencies>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-sales</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-common</artifactId>
        </dependency>
        <!-- 实体/DTO 的 getter/setter 与构造（与其它业务模块一致用 provided 作用域）。
             ★ M4-B15：本模块此前只有 core 常量类、无 Lombok 依赖；B15 引入 @Data 实体后必须补齐，
             否则注解处理器不生效、getter 全部缺失（编译期即暴露）。版本由 spring-boot-dependencies 管理。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
