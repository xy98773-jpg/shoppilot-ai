<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shoppilot</groupId>
        <artifactId>shoppilot-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shoppilot-inventory</artifactId>
    <name>ShopPilot Inventory</name>
    <description>库存（依赖：catalog, common）</description>

    <dependencies>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-common</artifactId>
        </dependency>
        <!-- M3-T17（B9）：审计埋点。依据 MODULE_BOUNDARIES §2.10 / F-40——audit 是叶子模块，
             任何业务模块均可依赖（catalog → audit、sales → audit 已有先例），inventory → audit 不成环。
             B6 时本模块刻意不依赖 audit（「审计归 B9」），本批按任务书正式引入。
             版本由父 pom 的 dependencyManagement 管理，此处不写 <version>。 -->
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-audit</artifactId>
        </dependency>
        <!-- M3-T09（B6）：实体/DTO 的 getter/setter 与构造。与其它业务模块一致用 provided 作用域
             （编译期注解处理，不进运行时依赖）。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
