<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shoppilot</groupId>
    <artifactId>shoppilot-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>ShopPilot AI Parent</name>
    <description>电商库存决策与采购协同平台 - Java 多模块父工程（11 模块）</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- JWT 库（TECH_STACK.md §1.2：jjwt 0.12.x）；Boot BOM 不管理 jjwt，故在此统一版本 -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <modules>
        <module>common</module>
        <module>identity</module>
        <module>catalog</module>
        <module>importdata</module>
        <module>inventory</module>
        <module>sales</module>
        <module>analysis</module>
        <module>replenishment</module>
        <module>purchasing</module>
        <module>audit</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM：仅管理依赖版本，不引入任何依赖 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块：统一版本，子模块引用时无需再写 version -->
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-common</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-identity</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-catalog</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-importdata</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-inventory</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-sales</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-analysis</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-replenishment</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-purchasing</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-audit</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.shoppilot</groupId><artifactId>shoppilot-app</artifactId><version>${project.version}</version></dependency>

            <!-- 架构守护：模块依赖断言（M2 启用逐模块白名单） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <!-- ★ M2-T02 修复：Spring Framework 6.1+ 解析 @PathVariable / @RequestParam /
                             @RequestParam 绑定与构造器参数名时【不再】依赖 debug 信息，而是要求
                             编译器写入 MethodParameters 属性（-parameters）。本项目使用自定义父 pom
                             （未继承 spring-boot-starter-parent，后者默认开启该标志），故必须显式开启；
                             否则运行期抛 IllegalArgumentException:
                             "Name for argument of type [...] not specified ... Ensure that the
                             compiler uses the '-parameters' flag."（表现为 500 + COM-0002）。 -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
