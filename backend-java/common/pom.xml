<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shoppilot</groupId>
        <artifactId>shoppilot-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shoppilot-common</artifactId>
    <name>ShopPilot Common</name>
    <description>基础设施与公共组件（框架底座；无业务表、无业务逻辑）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- M2-T07：AOP（@Aspect 切面 + AspectJ 织入）。仅承载「声明式鉴权」横切关注点；
             common 仍只依赖框架，不依赖任何业务模块。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- M1-T04：Spring Security 6.5.x（随 Boot 3.5 管理，无需指定版本）。
             仅提供过滤器链骨架与 401 JSON 序列化；common 仍只依赖框架，不依赖任何业务模块。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.17</version>
        </dependency>
        <!-- 3.5.17 起 TenantLineInnerInterceptor 等拆入此模块，starter 不传递，需显式引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>
        <!-- M8-T02（R195 / NFR-OBS-02）：Micrometer 埋点 API。版本随 spring-boot-dependencies BOM 管理。
             ★ 只引 micrometer-core，不引 spring-boot-starter-actuator——注册表与端点暴露
             仍由 app（组合根）决定，common 不把观测栈的「装配」拽进来。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
