<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shoppilot</groupId>
        <artifactId>shoppilot-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shoppilot-importdata</artifactId>
    <name>ShopPilot ImportData</name>
    <description>数据导入（依赖：catalog, inventory, sales, common）</description>

    <dependencies>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-sales</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-common</artifactId>
        </dependency>
        <!-- M3-T02：创建批次需埋 IMPORT_BATCH_CREATE（审计 #8）。
             audit 为叶子模块（仅依赖 common），importdata → audit 不构成环
             （同 catalog → audit，MODULE_BOUNDARIES §2.10 / F-40 裁定）。 -->
        <dependency>
            <groupId>com.shoppilot</groupId>
            <artifactId>shoppilot-audit</artifactId>
        </dependency>
        <!-- Lombok 为 provided 作用域、不跨模块继承：每个使用 @Data 的模块都必须自行声明
             （同 catalog / audit / identity / common），否则 getter 不生成、编译失败。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- M3-T03：Excel 解析（项目负责人裁定 C 批准引入 Apache POI；禁 EasyExcel 等其它库）。
             ★ 版本【显式指定 5.3.0】：已实测 spring-boot-dependencies:3.5.16 的 BOM 不含
               org.apache.poi（grep 计数 0），故不写版本会直接 "version is missing" 构建失败。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
    </dependencies>
</project>
